# Entorno virtual de Python (cada uno crea el suyo con requirements.txt)
.venv/

# Ficheros que genera Python al ejecutar
__pycache__/

# El ejecutable que genera crear_exe.bat (cada uno lo genera con doble clic)
ASTERIXDecoder.exe

# Caché de un complemento del editor, no es del proyecto
.impeccable/
